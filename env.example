# Senbon environment template
# Copy to .env.local and fill in.

# --- Site ---
NEXT_PUBLIC_SITE_URL="https://senbon.ch"

# --- Guestbook ---
# Guestbook API.
# Both values are server-only. Never prefix them with NEXT_PUBLIC_, since the
# token grants write access. Leave either blank to render the "paused" notice.
GUESTBOOK_API_URL="https://api.senbon.ch"
GUESTBOOK_API_TOKEN=""

# --- Guestbook moderation (/guestbook/admin) ---
# ADMIN_TOKEN is the admin secret for the guestbook API.
# ADMIN_PASSWORD is what you type into the login form. Both server-only.
GUESTBOOK_ADMIN_TOKEN=""
GUESTBOOK_ADMIN_PASSWORD=""
