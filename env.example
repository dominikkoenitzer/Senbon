# Senbon environment template
# Copy to .env.local and fill in.

# --- Site ---
NEXT_PUBLIC_SITE_URL="https://senbon.ch"

# --- Guestbook ---
# Supabase project. Both values are server-only. Never prefix them with
# NEXT_PUBLIC_: the secret key bypasses row level security and is the whole of
# the guestbook's write and moderation access. Leave either blank to render the
# "offline" notice instead of erroring.
#
# Either a new-style secret key (sb_secret_...) or the legacy service_role JWT
# works here. The deployed value is the sb_secret key; get it with
# `bun x supabase projects api-keys --reveal` (without --reveal it is masked).
SUPABASE_URL="https://<project-ref>.supabase.co"
SUPABASE_SECRET_KEY=""

# --- Guestbook moderation (/guestbook/admin) ---
# ADMIN_TOKEN keys every HMAC in the guestbook: the admin session cookie, the
# sign-in throttle and the stored visitor hashes. Rotating it signs every
# admin out. ADMIN_PASSWORD is what you type into the login form. Both
# server-only.
GUESTBOOK_ADMIN_TOKEN=""
GUESTBOOK_ADMIN_PASSWORD=""
